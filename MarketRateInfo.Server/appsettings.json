{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/marketrateinfo.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/market-rates-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "MinimumLevel": "Error",
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "Logs/errors-.log",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 30,
                  "shared": true
                }
              }
            ]
          }
        }
      }
    ]
  },
  "MarketRates": {
    "Frankfurter": {
      "Enabled": true,
      "BaseUrl": "https://api.frankfurter.dev/",
      "TimeoutSeconds": 10
    },
    "ExchangeRateApi": {
      "Enabled": true,
      "BaseUrl": "https://open.er-api.com/",
      "TimeoutSeconds": 10
    },
    "CryptoRateApi": {
      "Enabled": true,
      "BaseUrl": "https://api.coingecko.com/api/v3/",
      "TimeoutSeconds": 10
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "Admin": {
      "Email": "admin@marketrateinfo.local"
    }
  }
}
